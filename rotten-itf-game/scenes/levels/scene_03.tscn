[node name="DialogueTrigger" parent="." unique_id=413688381 node_paths=PackedStringArray("amulet", "high_priestess") instance=ExtResource("5_0760f")]
process_mode = 3
script = ExtResource("6_nuytq")
dialogue_lines = Array[String](["High Priestess!", "Daphne, stay back.", "You're... Oh, Godess", "I lasted as long as I could in this ruined Temple, but even my Patron Demeter could only protect me for so long.", "It appears that the powers of this Rotten substance have only grown stronger in your absence. At times, I wondered…", "I wondered if maybe it grew because it was seeking you out.", "What do you mean?", "You were there that night when it appeared. It wasn’t just growing out of Persephone’s altarpiece, it was growing out towards you.", "No, it… it ate away at my sisters. I watched it grow in all directions to infect the Temple.", "Your sisters, yes, but not your kin. Kind girl… I was wrong. It was not your fault. I see that now.", "You were not born of this Temple. You were given to us out by the Yew tree. ", "I thought you were some Nymph’s forgotten babe, but no… I took you from a far more sordid heritage.", "High Priestess, what are you saying?", "You aren’t of our lands, Daphne. Which is why you need to be the only to save us.", "Purify the Rot from this place, girl, and you will be granted the power to control this infection.", "Then, go to the old living chambers, and learn of its origin. ", "Of your origin.", "There are letters. She… she wrote of it… Please. You must know.", "Goddess, forgive me. Forgive me."])
speaker = Array[String](["Daphne", "High Priestess", "Daphne", "High Priestess", "High Priestess", "High Priestess", "Daphne", "High Priestess", "Daphne", "High Priestess", "High Priestess", "High Priestess", "Daphne", "High Priestess", "High Priestess", "High Priestess", "High Priestess", "High Priestess", "High Priestess"])
amulet = NodePath("../Amulet")
high_priestess = NodePath("../HighPriestess")

