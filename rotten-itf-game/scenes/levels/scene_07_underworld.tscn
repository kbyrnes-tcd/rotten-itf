lio_text = "His office. Quiet. "
seq_text = Array[String]([""])

[node name="LioPreOffice2" parent="LIOs" unique_id=1617503641 instance=ExtResource("9_0as34")]
position = Vector2(1953.9999, 259)
scale = Vector2(2.3600197, 1)
lio_text = "No… I can hear him in there. He is speaking with someone so quietly I can hardly make it out."

[node name="LIOOFFICE" parent="LIOs" unique_id=856708270 instance=ExtResource("9_0as34")]
position = Vector2(2085, 259)
scale = Vector2(10.7292385, 1)
lio_text = ""
seq = true
seq_text = Array[String](["“Yes, brother. I know.” ", "“Too many years have passed now and I’m growing impatient.”", "“Our deal must end.”", "“Persephone must not leave again. I will not allow it.”", "...", "No.", "He… he can’t do this. He can’t.", "He can’t."])
hades = true

