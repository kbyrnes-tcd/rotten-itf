[node name="LIOs" type="Node2D" parent="." unique_id=1452585461]

[node name="LioSeqTrigger" parent="LIOs" unique_id=2072932904 instance=ExtResource("9_0as34")]
position = Vector2(507, 260)
scale = Vector2(5.4562945, 1)
lio_text = ""
seq = true
seq_text = Array[String](["Strange… no matter how cold it gets up above, it’s always just the same sweltering smog down here.", "This year is especially bad. It’s hard even to breathe in my garden. I worry I’ll need a greenhouse soon. I don’t think I can go outside."])

[node name="LioSeqTrigger2" parent="LIOs" unique_id=110257511 instance=ExtResource("9_0as34")]
position = Vector2(-102, 260)
scale = Vector2(21.319998, 1.0351171)
lio_text = ""
seq = true
seq_text = Array[String](["My mother sent me down this winter with Lilly and lavender seeds, but they’re struggling in this pollution.", "I suppose I should keep a few, and plant them in the garden when I return in the Spring. ", "Maybe my Amulet will help some of it to grow. I left it with my Mother, but I should retrieve my ruby sigil when I return. ", "It has long helped my plants to grow, though it’s power is not as strong here as it is above. The winter time is harsh on me. "])

[node name="LioSeqTriggerx" parent="LIOs" unique_id=204776901 instance=ExtResource("9_0as34")]
position = Vector2(943, 260)
scale = Vector2(23.919994, 1)
lio_text = ""
seq = true
seq_text = Array[String](["My husband. I may not love Hades, but I have to admit half a life is long enough to grow familiar enough. His presence has become as equal in my life as that of my mother, or my gardens, or my blood.", "He is the king of this realm and, as king, he asks for nothing. He acquiesces to nothing. He appeals to nothing. He is, he wants, he has. His will is the way, and sometimes that will extend to the wants of his wife. ", "I see… oddly little of him. This has been one of the winters he avoids me. Some days, I will glimpse an edge of him, a shoulder, a finger, through the chilled, cold halls of our home here, and he will not even stop to acknowledge me.", "He seems… guilty.", "I don’t like it. It feels wrong. I think something is wrong.", "I think I’m… scared."])

[node name="LioSeqTriggerx2" parent="LIOs" unique_id=588385984 instance=ExtResource("9_0as34")]
position = Vector2(1469, 260)
scale = Vector2(22.799995, 1)
lio_text = ""
seq = true
seq_text = Array[String](["Even after my many years in this deal, I’m still always under watch. I wonder how many winters I’ve spent here…", "I was so young that first Autumn I came here through the Yew Tree, but I’ve spent almost half my life here. When exactly will it start feeling like home?", "Maybe when it stops feeling like a prison. Or tomb."])

[node name="LioSeqTriggerx3" parent="LIOs" unique_id=1617503641 instance=ExtResource("9_0as34")]
position = Vector2(1971, 260)
scale = Vector2(10.600019, 1)
lio_text = ""
display_duration = 0.1
seq_text = Array[String](["His office. Quiet. ", "No… I can hear him in there. He is speaking with someone so quietly I can hardly make it out."])

