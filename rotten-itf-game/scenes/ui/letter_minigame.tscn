[sub_resource type="GDScript" id="GDScript_0n18g"]
script/source = "extends Node2D

signal minigame_complete


# ============================================================
# PUZZLE DATA
# ============================================================

var gaps = [
	{
		\"before\": \"I am glad to be at peace here in my home. I am settling\",
		\"after\": \"in comfortably this winter, and have been enjoying the company of my husband.\",
		\"correct\": \"SOMETHING\"
	},
	{
		\"before\": \"We are quite well, and have been enjoying the good weather.\",
		\"after\": \"My lavender bush is thriving,\",
		\"correct\": \"IS\"
	},
	{
		\"before\": \", and I plan to\",
		\"after\": \"grow some more in my chambers.\",
		\"correct\": \"WRONG\"
	},
	{
		\"before\": \"Though I miss the sun, stars, and you\",
		\"after\": \", my family here is flourishing.\",
		\"correct\": \"WITH\"
	},
	{
		\"before\": \"I miss you dearly, and am\",
		\"after\": \"glad to see you soon.\",
		\"correct\": \"HADES\"
	}
]

var symbols = [
	\"SOMETHING\",
	\"IS\",
	\"WRONG\",
	\"WITH\",
	\"HADES\"
]


# ============================================================
# STATE
# ============================================================

var current_gap := 0
var solved_words := {}

var letter_finished := false
var reading_final_letter := false


# ============================================================
# NODES
# ============================================================

@onready var letter_text: RichTextLabel = $Letter/LetterText
@onready var gap_box: TextureRect = $Letter/GapBox
@onready var gap_label: Label = $Letter/GapBox/GapLabel

@onready var symbol_grid: GridContainer = $SymbolPanel/SymbolGrid

@onready var feedback: Label = $Feedback
@onready var continue_button: Button = $Continue


# ============================================================
# READY
# ============================================================

func _ready():

	# Allows the minigame to work while the main game is paused.
	process_mode = Node.PROCESS_MODE_ALWAYS

	feedback.visible = false
	continue_button.visible = false

	continue_button.pressed.connect(_on_continue_pressed)

	build_symbol_buttons()

	show_gap()


# ============================================================
# CREATE SYMBOL BUTTONS
# ============================================================

func build_symbol_buttons():

	# Remove existing buttons.
	for child in symbol_grid.get_children():
		child.queue_free()

	for symbol in symbols:

		var button := Button.new()

		button.text = symbol

		button.custom_minimum_size = Vector2(150, 80)

		button.focus_mode = Control.FOCUS_NONE

		var selected_symbol = symbol

		button.pressed.connect(
			func():
				select_symbol(selected_symbol)
		)

		symbol_grid.add_child(button)


# ============================================================
# SHOW CURRENT GAP
# ============================================================

func show_gap():

	if current_gap >= gaps.size():
		finish_puzzle()
		return

	var gap = gaps[current_gap]

	# Show the constellation placeholder.
	gap_box.visible = true

	gap_label.text = \"?\"

	feedback.visible = false


# ============================================================
# PLAYER SELECTS SYMBOL
# ============================================================

func select_symbol(symbol: String):

	var gap = gaps[current_gap]

	if symbol == gap[\"correct\"]:

		correct_answer(symbol)

	else:

		wrong_answer()


# ============================================================
# CORRECT ANSWER
# ============================================================

func correct_answer(symbol: String):

	solved_words[current_gap] = symbol

	# Replace the constellation with the word.
	gap_label.text = symbol

	feedback.text = \"That feels right.\"
	feedback.visible = true

	# Small pause before moving to next gap.
	await get_tree().create_timer(0.6).timeout

	current_gap += 1

	show_gap()


# ============================================================
# WRONG ANSWER
# ============================================================

func wrong_answer():

	feedback.text = \"Hmm... that doesn't feel right.\"
	feedback.visible = true

	shake_gap()

	await get_tree().create_timer(1.2).timeout

	feedback.visible = false


# ============================================================
# SHAKE CONSTELLATION BOX
# ============================================================

func shake_gap():

	var original_position := gap_box.position

	var tween := create_tween()

	tween.tween_property(
		gap_box,
		\"position\",
		original_position + Vector2(8, 0),
		0.05
	)

	tween.tween_property(
		gap_box,
		\"position\",
		original_position + Vector2(-8, 0),
		0.05
	)

	tween.tween_property(
		gap_box,
		\"position\",
		original_position + Vector2(8, 0),
		0.05
	)

	tween.tween_property(
		gap_box,
		\"position\",
		original_position,
		0.05
	)


# ============================================================
# PUZZLE COMPLETE
# ============================================================

func finish_puzzle():

	letter_finished = true

	# Hide constellation.
	gap_box.visible = false

	# Hide choices.
	$SymbolPanel.visible = false

	# Build the final letter.
	letter_text.text = build_complete_letter()

	feedback.text = \"The letter is complete.\"
	feedback.visible = true

	continue_button.visible = true

	continue_button.text = \"Continue\"


# ============================================================
# BUILD FINAL LETTER
# ============================================================

func build_complete_letter() -> String:

	var full_letter := \"\"

	for i in gaps.size():

		var gap = gaps[i]

		var word = solved_words.get(
			i,
			gap[\"correct\"]
		)

		full_letter += gap[\"before\"]
		full_letter += \" \"
		full_letter += word
		full_letter += \" \"
		full_letter += gap[\"after\"]

		full_letter += \"\\n\\n\"

	return full_letter


# ============================================================
# CONTINUE
# ============================================================

func _on_continue_pressed():

	if not reading_final_letter:

		reading_final_letter = true

		continue_button.text = \"POV shift\"

		feedback.text = \"She sealed the letter...\"
		feedback.visible = true

		$Letter.visible = false

	else:

		minigame_complete.emit()

		GameGlobals.unload_minigame()
"

